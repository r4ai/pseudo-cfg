{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pseudo-cfg",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script runs, so there is no server-side attack surface.
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "404-page",
  },
  // The pseudo-cfg.r4ai.dev custom domain is attached once by hand, not here:
  // declaring it would make every deploy need Workers Routes permission on the zone.
  "workers_dev": true,
  "preview_urls": false,
}
