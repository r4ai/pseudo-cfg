{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pseudo-cfg",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script runs, so there is no server-side attack surface.
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "pseudo-cfg.r4ai.dev", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
}
