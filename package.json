{
  "name": "pseudo-cfg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "waku dev",
    "build": "waku build && node scripts/write-headers.ts",
    "start": "waku start",
    "typegen": "waku router typegen",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm react-doctor",
    "react-doctor": "react-doctor . --no-telemetry --yes",
    "cf:deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
